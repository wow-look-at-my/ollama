#!/bin/bash
#
# nvcc compilation cache that deduplicates identical virtual architectures.
#
# For each nvcc invocation with multiple -gencode flags, this wrapper:
# 1. Preprocesses the source for each virtual arch and hashes the output
# 2. Builds a cache key from the unique set of preprocessed hashes
# 3. On cache hit: copies the cached object file directly (skips nvcc)
# 4. On cache miss: compiles with only the unique arches, caches the result
#
# SASS arches (code=sm_*) are never deduplicated — they produce
# architecture-specific machine code even from identical source.
#
# Set CMAKE_CUDA_COMPILER_LAUNCHER to this script.

set -euo pipefail

NVCC="$1"
shift

OTEL_ENDPOINT="${OTEL_ENDPOINT:-https://otel.pazer.tube/v1/logs}"
log() {
    echo "[nvcc-dedup] $*" >&2
    local payload
    payload=$(jq -nc --arg msg "$*" --arg ts "$(date +%s)000000000" \
        '{resourceLogs:[{resource:{attributes:[{key:"service.name",value:{stringValue:"nvcc-dedup"}}]},scopeLogs:[{scope:{name:"nvcc-dedup"},logRecords:[{body:{stringValue:$msg},timeUnixNano:$ts,severityText:"INFO"}]}]}]}')
    curl -s -X POST "$OTEL_ENDPOINT" -H 'Content-Type: application/json' -d "$payload" >/dev/null 2>&1 || true
}

CACHE_DIR="${NVCC_DEDUP_CACHE_DIR:-/tmp/nvcc-dedup-cache}"
mkdir -p "$CACHE_DIR"

# Find the output file (-o flag) and source file (.cu).
output_file=""
src_file=""
prev=""
include_flags=()
for arg in "$@"; do
    if [ "$prev" = "-o" ]; then
        output_file="$arg"
    fi
    case "$arg" in
        *.cu) src_file="$arg" ;;
        -I*|-isystem*|--include-path*) include_flags+=("$arg") ;;
    esac
    prev="$arg"
done

# If no output or source, or <= 1 gencode, just pass through.
gencode_count=0
for arg in "$@"; do
    case "$arg" in -gencode*|--generate-code*) gencode_count=$((gencode_count + 1));; esac
done
if [ -z "$output_file" ] || [ -z "$src_file" ] || [ ! -f "$src_file" ] || [ "$gencode_count" -le 1 ]; then
    exec "$NVCC" "$@"
fi

log "Processing $(basename "$src_file") with $gencode_count gencode flags"
for arg in "$@"; do
    case "$arg" in -gencode*|--generate-code*) log "  arg: '$arg'"; break;; esac
done
t_start=$SECONDS

# Preprocess each virtual arch, hash the output, group by hash.
declare -A hash_to_first_arch  # hash -> first -gencode flag with this hash
declare -A arch_hashes         # -gencode flag -> hash
sass_gencodes=()
virtual_gencodes=()

for arg in "$@"; do
    case "$arg" in
        -gencode=*|--generate-code=*)
            gencode="${arg#*=}"

            # Detect virtual: check if compute_ appears in the code= value.
            # Handles all cmake formats: code=compute_75, code=[compute_75,sm_75], etc.
            if [[ "$gencode" != *code=*compute_* ]]; then
                sass_gencodes+=("$arg")
                continue
            fi

            virtual_gencodes+=("$arg")
            arch_val=""
            [[ "$gencode" =~ arch=(compute_[a-z0-9]+) ]] && arch_val="${BASH_REMATCH[1]}"

            if [ -n "$arch_val" ]; then
                # Strip the arch-specific number from preprocessed output.
                # __CUDA_ARCH__ expands to e.g. 800, __CUDA_ARCH_LIST__ to
                # the single arch number when preprocessing individually.
                # Replace that specific number so equivalent arches hash same.
                arch_num="${arch_val#compute_}"
                pp_hash=$("$NVCC" -E -arch="$arch_val" "${include_flags[@]}" "$src_file" 2>/dev/null \
                    | grep -v '^#' \
                    | sed "s/${arch_num}/0/g" \
                    | md5sum | cut -d' ' -f1) || pp_hash="$arg"
                arch_hashes["$arg"]="$pp_hash"
                if [ -z "${hash_to_first_arch[$pp_hash]+x}" ]; then
                    hash_to_first_arch["$pp_hash"]="$arg"
                fi
            fi
            ;;
    esac
done

# Build the set of unique virtual gencodes.
unique_gencodes=()
for arg in "${virtual_gencodes[@]}"; do
    h="${arch_hashes[$arg]}"
    if [ "${hash_to_first_arch[$h]}" = "$arg" ]; then
        unique_gencodes+=("$arg")
    fi
done

t_preprocess=$((SECONDS - t_start))
n_virtual=${#virtual_gencodes[@]}
n_unique=${#unique_gencodes[@]}
n_sass=${#sass_gencodes[@]}
log "  preprocessed in ${t_preprocess}s: ${n_virtual} virtual -> ${n_unique} unique, ${n_sass} sass"

# One-time: dump diff between first two arches to diagnose why they hash differently
if [ "$n_unique" -eq "$n_virtual" ] && [ "$n_virtual" -ge 2 ] && [ ! -f /tmp/nvcc-dedup-diffed ]; then
    touch /tmp/nvcc-dedup-diffed
    a1="${virtual_gencodes[0]}"
    a2="${virtual_gencodes[1]}"
    g1="${a1#*=}"; av1=""; [[ "$g1" =~ arch=(compute_[a-z0-9]+) ]] && av1="${BASH_REMATCH[1]}"
    g2="${a2#*=}"; av2=""; [[ "$g2" =~ arch=(compute_[a-z0-9]+) ]] && av2="${BASH_REMATCH[1]}"
    n1="${av1#compute_}"; n2="${av2#compute_}"
    "$NVCC" -E -arch="$av1" "${include_flags[@]}" "$src_file" 2>/dev/null | grep -v '^#' | sed "s/${n1}/0/g" > /tmp/pp1.txt
    "$NVCC" -E -arch="$av2" "${include_flags[@]}" "$src_file" 2>/dev/null | grep -v '^#' | sed "s/${n2}/0/g" > /tmp/pp2.txt
    difflines=$(diff /tmp/pp1.txt /tmp/pp2.txt | head -20)
    log "  DIFF between $av1 and $av2: $difflines"
fi

# Cache key: hash of (all non-gencode flags + unique gencode set + source hash).
src_hash=$(md5sum "$src_file" | cut -d' ' -f1)
flags_for_key=""
for arg in "$@"; do
    case "$arg" in -gencode*|--generate-code*) ;; *) flags_for_key+="$arg ";; esac
done
for g in "${unique_gencodes[@]}" "${sass_gencodes[@]}"; do
    flags_for_key+="$g "
done
cache_key=$(printf '%s\n%s' "$flags_for_key" "$src_hash" | md5sum | cut -d' ' -f1)
cached="$CACHE_DIR/$cache_key.o"

# Cache hit: copy cached object file.
if [ -f "$cached" ]; then
    log "  CACHE HIT -> $output_file"
    cp "$cached" "$output_file"
    exit 0
fi

# Cache miss: compile with only unique arches + all SASS arches.
new_args=()
for arg in "$@"; do
    case "$arg" in
        -gencode=*|--generate-code=*)
            ;;
        *)
            new_args+=("$arg")
            ;;
    esac
done
new_args+=("${unique_gencodes[@]}" "${sass_gencodes[@]}")

t_compile_start=$SECONDS
"$NVCC" "${new_args[@]}"
t_compile=$((SECONDS - t_compile_start))
log "  compiled in ${t_compile}s (${n_unique} arches instead of ${n_virtual})"

# Cache the result.
if [ -f "$output_file" ]; then
    cp "$output_file" "$cached"
fi

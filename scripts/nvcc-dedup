#!/bin/bash
#
# Compilation cache wrapper for nvcc. Preprocesses the source using the
# real compiler with the real flags, hashes the result, and returns a
# cached object file on hit. On miss, compiles and caches the output.
#
# Set CMAKE_CUDA_COMPILER_LAUNCHER to this script.

set -euo pipefail

NVCC="$1"
shift

CACHE_DIR="${NVCC_DEDUP_CACHE_DIR:-/tmp/nvcc-dedup-cache}"
mkdir -p "$CACHE_DIR"

OTEL_ENDPOINT="${OTEL_ENDPOINT:-https://otel.pazer.tube/v1/logs}"
log() {
    echo "[nvcc-dedup] $*" >&2
    jq -nc --arg msg "$*" --arg ts "$(date +%s)000000000" \
        '{resourceLogs:[{resource:{attributes:[{key:"service.name",value:{stringValue:"nvcc-dedup"}}]},scopeLogs:[{scope:{name:"nvcc-dedup"},logRecords:[{body:{stringValue:$msg},timeUnixNano:$ts,severityText:"INFO"}]}]}]}' \
    | curl -s -X POST "$OTEL_ENDPOINT" -H 'Content-Type: application/json' -d @- >/dev/null 2>&1 || true
}

# Find the source file and output file.
output_file=""
src_file=""
prev=""
for arg in "$@"; do
    [ "$prev" = "-o" ] && output_file="$arg"
    case "$arg" in *.cu) src_file="$arg" ;; esac
    prev="$arg"
done

# No source or output → passthrough.
if [ -z "$output_file" ] || [ -z "$src_file" ] || [ ! -f "$src_file" ]; then
    exec "$NVCC" "$@"
fi

# Preprocess with the real compiler and real flags, hash the result.
t_start=$SECONDS
pp_hash=$("$NVCC" -E "$@" 2>/dev/null | md5sum | cut -d' ' -f1) || pp_hash=""

if [ -z "$pp_hash" ]; then
    log "$(basename "$src_file"): preprocess failed, compiling directly"
    exec "$NVCC" "$@"
fi

t_pp=$((SECONDS - t_start))
cached="$CACHE_DIR/$pp_hash.o"

if [ -f "$cached" ]; then
    cp "$cached" "$output_file"
    log "$(basename "$src_file"): cache hit (${t_pp}s preprocess)"
    exit 0
fi

t_compile_start=$SECONDS
"$NVCC" "$@"
t_compile=$((SECONDS - t_compile_start))

[ -f "$output_file" ] && cp "$output_file" "$cached"
log "$(basename "$src_file"): cache miss, compiled ${t_compile}s (${t_pp}s preprocess)"

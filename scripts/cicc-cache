#!/bin/bash
#
# cicc wrapper that caches device compiler output by input content hash.
#
# Install by replacing cicc with this wrapper:
#   mv /usr/local/cuda/nvvm/bin/cicc /usr/local/cuda/nvvm/bin/cicc.real
#   cp scripts/cicc-cache /usr/local/cuda/nvvm/bin/cicc

set -euo pipefail

REAL_CICC="${0}.real"
CACHE_DIR="${CICC_CACHE_DIR:-/tmp/cicc-cache}"
mkdir -p "$CACHE_DIR"

OTEL_ENDPOINT="${OTEL_ENDPOINT:-https://otel.pazer.tube/v1/logs}"
log() {
    echo "[cicc-cache] $*" >&2
    jq -nc --arg msg "$*" --arg ts "$(date +%s)000000000" \
        '{resourceLogs:[{resource:{attributes:[{key:"service.name",value:{stringValue:"cicc-cache"}}]},scopeLogs:[{scope:{name:"cicc-cache"},logRecords:[{body:{stringValue:$msg},timeUnixNano:$ts,severityText:"INFO"}]}]}]}' \
    | curl -s -X POST "$OTEL_ENDPOINT" -H 'Content-Type: application/json' -d @- >/dev/null 2>&1 || true
}

# Parse all args. Collect input file, and ALL flag-value pairs that
# look like output file paths.
input_file=""
declare -A output_map
prev=""
all_args=("$@")

# Log first invocation's full args for debugging
if [ ! -f /tmp/cicc-cache-logged ]; then
    touch /tmp/cicc-cache-logged
    log "args: $*"
fi

for arg in "$@"; do
    case "$prev" in
        -o|--gen_c_file_name|--stub_file_name|--gen_device_file_name|--module_id_file_name)
            output_map["$prev"]="$arg" ;;
    esac
    case "$arg" in *.cpp1.ii|*.cpp4.ii) input_file="$arg" ;; esac
    prev="$arg"
done

if [ -z "$input_file" ] || [ ! -f "$input_file" ] || [ ${#output_map[@]} -eq 0 ]; then
    exec "$REAL_CICC" "$@"
fi

input_hash=$(md5sum "$input_file" | cut -d' ' -f1)
cache_entry="$CACHE_DIR/$input_hash"

if [ -d "$cache_entry" ]; then
    for flag in "${!output_map[@]}"; do
        # Use flag name without leading dashes as cache filename
        clean_flag="${flag#--}"
        clean_flag="${clean_flag#-}"
        cached="$cache_entry/$clean_flag"
        target="${output_map[$flag]}"
        if [ -f "$cached" ]; then
            cp "$cached" "$target"
        else
            log "MISS for flag $flag (no $cached)"
            exec "$REAL_CICC" "$@"
        fi
    done
    log "HIT $(basename "$input_file")"
    exit 0
fi

"$REAL_CICC" "$@"

mkdir -p "$cache_entry"
for flag in "${!output_map[@]}"; do
    clean_flag="${flag#--}"
    clean_flag="${clean_flag#-}"
    src="${output_map[$flag]}"
    [ -f "$src" ] && cp "$src" "$cache_entry/$clean_flag"
done
log "STORE $(basename "$input_file") (${#output_map[@]} files)"
